# data/ 同步白名单: Parquet行情数据 + 用户配置
# 排除: 日志/锁/缓存/密钥/临时文件/机器特定数据

# --- 运行时日志 ---
data/backend.log
data/backend.log.*
data/uvicorn.out

# --- 进程锁文件 (跨机无意义) ---
data/.matrix_generation_*.lock
data/.mining_process.lock

# --- 机器特定生成标记 (含 owner_pid) ---
data/.matrix_generation_*.json

